{
  "name": "后台批量操作机器人",
  "description": "用大白话下指令，让 AI 看着屏幕自己点击、填写，批量处理网页后台里的重复操作。",
  "version": "1.118",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "webRequest",
    "tabs",
    "sidePanel",
    "debugger",
    "scripting",
    "storage",
    "alarms"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "./scripts/worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_icon": "icon128.png",
    "default_title": "后台批量操作机器人"
  },
  "side_panel": {
    "default_path": "./index.html"
  },
  "icons": {
    "128": "icon128.png"
  }
}